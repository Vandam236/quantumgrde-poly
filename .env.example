# Anthropic — REQUIRED for /research/[venue]/[slug] AI research briefs.
# Without this, the research page renders a setup prompt instead of a brief.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Polymarket — all endpoints used in the MVP are public, no key required.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Kalshi — public market data needs no key. Add only for trading or private endpoints.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=

# Supabase — phase 2, when we add persistence/alerts
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
